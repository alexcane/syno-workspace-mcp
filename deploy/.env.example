# Copy to .env next to docker-compose.yml, then fill in the secrets.
# Never commit the resulting .env.

# --- Synology DSM -----------------------------------------------------------
# DSM URL as seen from the NAS itself.
SYNO_DSM_URL=https://nas.example.com:5001
SYNO_VERIFY_TLS=true
# Dedicated DSM account without 2FA, allowed to use Synology Drive and Synology Office only.
SYNO_USERNAME=mcp_service
SYNO_PASSWORD=change-me

# --- Synology Spreadsheet API container --------------------------------------
SYNO_SS_API_URL=http://127.0.0.1:3000
# DSM URL the Spreadsheet container calls back, as seen from the NAS (defaults to
# SYNO_DSM_URL). Its certificate must be trusted by the container.
# SYNO_SS_DSM_URL=
# Required by the container, otherwise it restarts in a loop. `openssl rand -hex 32`
SS_AUTH_SECRET=change-me

# --- MCP server ----------------------------------------------------------------
SYNO_MODULES=drive,spreadsheet
# Loopback only: the DSM reverse proxy handles external exposure.
MCP_HOST=127.0.0.1
MCP_PORT=3100
# Bearer token for MCP clients, at least 32 characters. `openssl rand -hex 32`
MCP_AUTH_TOKEN=change-me
# Comma-separated hostnames clients use to reach the reverse proxy (Host header).
MCP_ALLOWED_HOSTS=nas.example.com

DATA_DIR=/data
LOG_LEVEL=INFO

# Image tag deployed by docker compose (never `latest` in production).
# MCP_IMAGE_TAG=0.4.0
